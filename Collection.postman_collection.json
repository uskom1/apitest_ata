  "item": [
    {
      "name": "Get All Products List",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "",
              "// Test 1: Status code is 200",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// Test 2: Response time is acceptable",
              "pm.test(\"Response time is less than 3000ms\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(3000);",
              "});",
              "",
              "// Test 3: Response has JSON content type",
              "pm.test(\"Content-Type is application/json\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
              "});",
              "",
              "// Test 4: Response body is valid JSON",
              "pm.test(\"Response body is valid JSON\", function () {",
              "    pm.response.to.be.json;",
              "});",
              "",
              "// Test 5: responseCode in body is 200",
              "pm.test(\"Response body responseCode is 200\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.responseCode).to.eql(200);",
              "});",
              "",
              "// Test 6: Response contains products array",
              "pm.test(\"Response contains 'products' array\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.property(\"products\");",
              "    pm.expect(json.products).to.be.an(\"array\");",
              "});",
              "",
              "// Test 7: Products array is not empty",
              "pm.test(\"Products array is not empty\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.products.length).to.be.above(0);",
              "});",
              "",
              "// Test 8: Each product has required fields",
              "pm.test(\"Each product has required fields: id, name, price, brand, category\", function () {",
              "    const json = pm.response.json();",
              "    json.products.forEach(function (product) {",
              "        pm.expect(product).to.have.property(\"id\");",
              "        pm.expect(product).to.have.property(\"name\");",
              "        pm.expect(product).to.have.property(\"price\");",
              "        pm.expect(product).to.have.property(\"brand\");",
              "        pm.expect(product).to.have.property(\"category\");",
              "    });",
              "});",
              "",
              "// Test 9: Each product id is a number",
              "pm.test(\"Each product 'id' is a number\", function () {",
              "    const json = pm.response.json();",
              "    json.products.forEach(function (product) {",
              "        pm.expect(product.id).to.be.a(\"number\");",
              "    });",
              "});",
              "",
              "// Test 10: Each product name is a non-empty string",
              "pm.test(\"Each product 'name' is a non-empty string\", function () {",
              "    const json = pm.response.json();",
              "    json.products.forEach(function (product) {",
              "        pm.expect(product.name).to.be.a(\"string\").and.not.empty;",
              "    });",
              "});",
              "",
              "// Test 11: Each product price is a non-empty string",
              "pm.test(\"Each product 'price' is a non-empty string\", function () {",
              "    const json = pm.response.json();",
              "    json.products.forEach(function (product) {",
              "        pm.expect(product.price).to.be.a(\"string\").and.not.empty;",
              "    });",
              "});",
              "",
              "// Test 12: Each product brand is a non-empty string",
              "pm.test(\"Each product 'brand' is a non-empty string\", function () {",
              "    const json = pm.response.json();",
              "    json.products.forEach(function (product) {",
              "        pm.expect(product.brand).to.be.a(\"string\").and.not.empty;",
              "    });",
              "});",
              "",
              "// Test 13: Each product category has usertype and category fields",
              "pm.test(\"Each product 'category' has 'usertype' and 'category' fields\", function () {",
              "    const json = pm.response.json();",
              "    json.products.forEach(function (product) {",
              "        pm.expect(product.category).to.have.property(\"usertype\");",
              "        pm.expect(product.category).to.have.property(\"category\");",
              "        pm.expect(product.category.usertype).to.have.property(\"usertype\");",
              "    });",
              "});",
              "",
              "// Test 14: Each product usertype is one of the expected values",
              "pm.test(\"Each product usertype is 'Women', 'Men', or 'Kids'\", function () {",
              "    const json = pm.response.json();",
              "    const validUserTypes = [\"Women\", \"Men\", \"Kids\"];",
              "    json.products.forEach(function (product) {",
              "        const userType = product.category.usertype.usertype;",
              "        pm.expect(validUserTypes).to.include(userType);",
              "    });",
              "});",
              "",
              "// Test 15: Product IDs are unique",
              "pm.test(\"All product IDs are unique\", function () {",
              "    const json = pm.response.json();",
              "    const ids = json.products.map(p => p.id);",
              "    const uniqueIds = [...new Set(ids)];",
              "    pm.expect(ids.length).to.eql(uniqueIds.length);",
              "});",
              "",
              "// Visualization",
              "var template = `",
              "<style>",
              "  body { font-family: Arial, sans-serif; padding: 16px; background: #f9f9f9; }",
              "  h2 { color: #333; margin-bottom: 12px; }",
              "  table { width: 100%; border-collapse: collapse; background: #fff; box-shadow: 0 1px 4px rgba(0,0,0,0.1); border-radius: 6px; overflow: hidden; }",
              "  th { background: #2c3e50; color: #fff; padding: 10px 14px; text-align: left; font-size: 13px; }",
              "  td { padding: 9px 14px; font-size: 13px; color: #444; border-bottom: 1px solid #eee; }",
              "  tr:nth-child(even) td { background: #f4f6f8; }",
              "  tr:hover td { background: #eaf0fb; }",
              "  .badge { display: inline-block; padding: 2px 8px; border-radius: 12px; font-size: 11px; font-weight: bold; }",
              "  .women { background: #fde8f0; color: #c0396b; }",
              "  .men   { background: #ddeeff; color: #1a5fa8; }",
              "  .kids  { background: #e8f8e8; color: #2a7a2a; }",
              "</style>",
              "<h2>Products List ({{count}} items)</h2>",
              "<table>",
              "  <thead>",
              "    <tr>",
              "      <th>#</th>",
              "      <th>Name</th>",
              "      <th>Price</th>",
              "      <th>Brand</th>",
              "      <th>User Type</th>",
              "      <th>Category</th>",
              "    </tr>",
              "  </thead>",
              "  <tbody>",
              "    {{#each products}}",
              "    <tr>",
              "      <td>{{id}}</td>",
              "      <td>{{name}}</td>",
              "      <td>{{price}}</td>",
              "      <td>{{brand}}</td>",
              "      <td><span class=\"badge {{userTypeClass}}\">{{userType}}</span></td>",
              "      <td>{{categoryName}}</td>",
              "    </tr>",
              "    {{/each}}",
              "  </tbody>",
              "</table>",
              "`;",
              "",
              "var jsonData = pm.response.json();",
              "var products = (jsonData.products || []).map(function(p) {",
              "    var ut = (p.category && p.category.usertype && p.category.usertype.usertype) || '';",
              "    var utClass = ut.toLowerCase();",
              "    return {",
              "        id: p.id,",
              "        name: p.name,",
              "        price: p.price,",
              "        brand: p.brand,",
              "        userType: ut,",
              "        userTypeClass: utClass,",
              "        categoryName: (p.category && p.category.category) || ''",
              "    };",
              "});",
              "",
              "pm.visualizer.set(template, { products: products, count: products.length });",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "packages": {},
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://automationexercise.com/api/productsList",
          "protocol": "https",
          "host": [
            "automationexercise",
            "com"
          ],
          "path": [
            "api",
            "productsList"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get All Brands List",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "",
              "// 1. Status code is 200",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// 2. Response time is less than 3000ms",
              "pm.test(\"Response time is less than 3000ms\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(3000);",
              "});",
              "",
              "// 3. Content-Type header contains \"application/json\"",
              "pm.test(\"Content-Type header contains application/json\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
              "});",
              "",
              "// 4. Response body is valid JSON",
              "pm.test(\"Response body is valid JSON\", function () {",
              "    pm.response.to.be.json;",
              "});",
              "",
              "// 5. Response body has a \"responseCode\" property equal to 200",
              "pm.test(\"Response body has responseCode equal to 200\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.property(\"responseCode\", 200);",
              "});",
              "",
              "// 6. Response body has a \"brands\" property",
              "pm.test(\"Response body has a brands property\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.property(\"brands\");",
              "});",
              "",
              "// 7. \"brands\" is an array",
              "pm.test(\"brands is an array\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.brands).to.be.an(\"array\");",
              "});",
              "",
              "// 8. \"brands\" array is not empty",
              "pm.test(\"brands array is not empty\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.brands).to.have.length.above(0);",
              "});",
              "",
              "// 9. Each brand object has an \"id\" field",
              "pm.test(\"Each brand object has an id field\", function () {",
              "    const json = pm.response.json();",
              "    json.brands.forEach(function (brand) {",
              "        pm.expect(brand).to.have.property(\"id\");",
              "    });",
              "});",
              "",
              "// 10. Each brand object has a \"brand\" field",
              "pm.test(\"Each brand object has a brand field\", function () {",
              "    const json = pm.response.json();",
              "    json.brands.forEach(function (brand) {",
              "        pm.expect(brand).to.have.property(\"brand\");",
              "    });",
              "});",
              "",
              "// 11. Each brand \"id\" is a number",
              "pm.test(\"Each brand id is a number\", function () {",
              "    const json = pm.response.json();",
              "    json.brands.forEach(function (brand) {",
              "        pm.expect(brand.id).to.be.a(\"number\");",
              "    });",
              "});",
              "",
              "// 12. Each brand \"brand\" is a non-empty string",
              "pm.test(\"Each brand name is a non-empty string\", function () {",
              "    const json = pm.response.json();",
              "    json.brands.forEach(function (brand) {",
              "        pm.expect(brand.brand).to.be.a(\"string\").and.to.have.length.above(0);",
              "    });",
              "});",
              "",
              "// 13. All brand IDs are unique",
              "pm.test(\"All brand IDs are unique\", function () {",
              "    const json = pm.response.json();",
              "    const ids = json.brands.map(function (b) { return b.id; });",
              "    const uniqueIds = new Set(ids);",
              "    pm.expect(uniqueIds.size).to.equal(ids.length);",
              "});",
              "",
              "// 14. Known brands are present in the list",
              "pm.test(\"Known brands are present in the list\", function () {",
              "    const json = pm.response.json();",
              "    const brandNames = json.brands.map(function (b) { return b.brand; });",
              "    const knownBrands = [\"Polo\", \"H&M\", \"Madame\", \"Mast & Harbour\", \"Babyhug\", \"Allen Solly Junior\", \"Kookie Kids\", \"Biba\"];",
              "    knownBrands.forEach(function (name) {",
              "        pm.expect(brandNames).to.include(name);",
              "    });",
              "});",
              "",
              "// 15. Response contains at least 30 brands",
              "pm.test(\"Response contains at least 30 brands\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.brands.length).to.be.at.least(30);",
              "});",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://automationexercise.com/api/brandsList",
          "protocol": "https",
          "host": [
            "automationexercise",
